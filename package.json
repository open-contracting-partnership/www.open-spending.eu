{
  "name": "www.open-spending.eu",
  "version": "1.0.0",
  "description": "Asset build (SCSS/JS) for the Open Spending Coalition WordPress theme",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow yarn",
    "dev": "npm run development",
    "development": "mix",
    "watch": "mix watch",
    "watch-poll": "mix watch -- --watch-options-poll=1000",
    "hot": "mix watch --hot",
    "prod": "npm run production",
    "production": "mix --production"
  },
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "autoprefixer": "^10.4.13",
    "laravel-mix": "^6.0.49",
    "postcss": "^8.4.21",
    "resolve-url-loader": "5.0.0",
    "sass": "^1.58.3",
    "sass-loader": "12.1.0",
    "tailwindcss": "3.2.7"
  },
  "dependencies": {
    "import-glob-loader": "^1.1.0"
  }
}
