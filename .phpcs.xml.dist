<?xml version="1.0"?>
<ruleset name="OpenSpendingCoalition">
    <description>Coding standards for the Open Spending Coalition theme: the WordPress standard, minus a short list of rules we've decided against and a shrinking list we haven't adopted yet.</description>

    <file>.</file>

    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/acf_json/*</exclude-pattern>
    <!-- Agent scratch space; .claude/worktrees holds checkouts of other branches,
         which would otherwise be linted as if they were part of this one. -->
    <exclude-pattern>*/.claude/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="parallel" value="8"/>

    <config name="testVersion" value="7.4-"/>
    <config name="minimum_supported_wp_version" value="6.1"/>
    <config name="text_domain" value="openspendingcoalition"/>

    <rule ref="WordPress">

        <!-- ==============================================================
             Deliberately not adopted. Decisions, not backlog.
             ============================================================== -->

        <!-- `'page' === $posttype` reads backwards. Yoda's purpose is to make
             the `if ( $x = 5 )` typo a parse error, and
             Generic.CodeAnalysis.AssignmentInCondition already reports that
             directly, so the readability cost buys nothing we don't have. -->
        <exclude name="WordPress.PHP.YodaConditions"/>

        <!-- Forcing every multi-item associative array onto multiple lines.
             All the hits are short nested config arrays like
             `array( 'slug' => 'news', 'with_front' => true )`, which cost three
             extra lines each and read worse for it. -->
        <exclude name="WordPress.Arrays.ArrayDeclarationSpacing.AssociativeArrayFound"/>

        <!-- FunctionCallSignature's multi-line sub-rules. These don't converge
             on the HTML-interleaved templates, where a call's arguments are
             routinely broken up by inline markup; re-flowing them is churn with
             no clarity gain. The single-line spacing rules stay on. -->
        <exclude name="PEAR.Functions.FunctionCallSignature.OpeningIndent"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.CloseBracketLine"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.ContentAfterOpenBracket"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.ContentBeforeCloseBracket"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.Indent"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.MultipleArguments"/>

        <!-- ==============================================================
             Not yet adopted. Backlog — see CODING_STANDARD_PLAN.md. Each is
             being worked through one rule per commit; this list should empty.
             ============================================================== -->

        <!-- Documentation. -->
        <exclude name="Squiz.Commenting.FileComment"/>
        <exclude name="Squiz.Commenting.FunctionComment"/>
        <exclude name="Squiz.Commenting.InlineComment"/>
        <exclude name="Generic.Commenting.DocComment"/>

        <!-- Naming and filenames. -->
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
        <exclude name="WordPress.NamingConventions.ValidFunctionName"/>
        <exclude name="WordPress.Files.FileName"/>

        <!-- Security and performance. -->
    </rule>

    <!-- These three build their markup entirely from escaped parts, so their
         return value is treated as already-escaped:

           breadcrumb_section()      — every interpolation goes through esc_url()
                                       or esc_html().
           main_query_pagination()   — core's paginate_links() output, wrapped in
           custom_query_pagination()   literal divs; the only injected values are
                                       prev_text/next_text, our own bundled SVGs.

         useSvg() is deliberately *not* listed here even though it would work —
         note that entries must be lowercase, as the sniff lowercases function
         names before matching, so a camelCase "useSvg" silently never matches
         and "usesvg" is what takes effect. It stays annotated per call-site
         instead: it returns raw file bytes for a path built by concatenating its
         argument, so listing it globally would also wave through a future
         useSvg( $untrusted ). The inline ignores keep each call site justified. -->
    <rule ref="WordPress.Security.EscapeOutput">
        <properties>
            <property name="customAutoEscapedFunctions" type="array">
                <element value="breadcrumb_section"/>
                <element value="custom_query_pagination"/>
                <element value="main_query_pagination"/>
            </property>
        </properties>
    </rule>

    <!-- Cross-version PHP compatibility checks -->
    <rule ref="PHPCompatibilityWP"/>
</ruleset>
