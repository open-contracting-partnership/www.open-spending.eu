<?xml version="1.0"?>
<ruleset name="OpenSpendingCoalition">
    <description>Coding standards for the Open Spending Coalition theme: the WordPress standard, minus the exclusions below.</description>

    <file>.</file>

    <exclude-pattern>*/.claude/*</exclude-pattern>
    <exclude-pattern>*/acf_json/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="parallel" value="8"/>

    <config name="testVersion" value="8.1-"/>
    <config name="minimum_supported_wp_version" value="6.1"/>
    <config name="text_domain" value="openspendingcoalition"/>

    <rule ref="WordPress">
        <!-- Yoda conditions read backwards, and Generic.CodeAnalysis.AssignmentInCondition
             already catches the `if ( $x = 5 )` typo they exist to prevent. -->
        <exclude name="WordPress.PHP.YodaConditions"/>

        <!-- Short config arrays are clearer on one line:
             array( 'slug' => 'news', 'with_front' => true ). -->
        <exclude name="WordPress.Arrays.ArrayDeclarationSpacing.AssociativeArrayFound"/>

        <!-- Multi-line call formatting doesn't converge on templates that break a
             call's arguments up with inline markup. Single-line spacing stays on. -->
        <exclude name="PEAR.Functions.FunctionCallSignature.OpeningIndent"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.CloseBracketLine"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.ContentAfterOpenBracket"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.ContentBeforeCloseBracket"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.Indent"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.MultipleArguments"/>

        <!-- These filenames are referenced by code, not just convention.
             archive.php and single.php locate their partials as
             '/archives/' . get_post_type() . '.php', so
             archives/best_practices.php has to keep its underscore — renaming it
             silently drops through to the generic layout rather than erroring.
             acf_block/*.php likewise match the ACF block names they render, and
             inc/_*.php marks the modules includes.php loads. -->
        <exclude name="WordPress.Files.FileName"/>
    </rule>

    <!-- These three assemble their markup from escaped parts only, so callers
         don't have to escape what they return. inline_svg() is not among them: it
         returns raw file contents, so it's justified per call-site instead. -->
    <rule ref="WordPress.Security.EscapeOutput">
        <properties>
            <property name="customAutoEscapedFunctions" type="array">
                <element value="breadcrumb_section"/>
                <element value="custom_query_pagination"/>
                <element value="main_query_pagination"/>
            </property>
        </properties>
    </rule>

    <!-- includes.php is nothing but require_once lines, and the sniff treats a
         docblock followed by a require as the require's, so it can't see the file
         comment that is there. -->
    <rule ref="Squiz.Commenting.FileComment.Missing">
        <exclude-pattern>inc/includes.php</exclude-pattern>
    </rule>

    <rule ref="PHPCompatibilityWP"/>
</ruleset>
