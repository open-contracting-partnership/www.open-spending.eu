<?xml version="1.0"?>
<ruleset name="OpenSpendingCoalition">
    <description>Coding standards for the Open Spending Coalition theme. Focuses on security and PHP/WP compatibility; style rules are intentionally narrow so CI stays useful rather than noisy.</description>

    <file>.</file>

    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/acf_json/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="parallel" value="8"/>

    <config name="testVersion" value="7.4-"/>
    <config name="minimum_supported_wp_version" value="6.1"/>
    <config name="text_domain" value="openspendingcoalition"/>

    <!-- Catch unsafe output. These helpers return pre-escaped/trusted markup, so
         their return value is treated as already-escaped. (useSvg is escaped per
         call-site with an inline ignore instead: this sniff does not honour it in
         customAutoEscapedFunctions.) -->
    <rule ref="WordPress.Security.EscapeOutput">
        <properties>
            <property name="customAutoEscapedFunctions" type="array">
                <element value="breadcrumb_section"/>
                <element value="custom_query_pagination"/>
                <element value="main_query_pagination"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.Security.NonceVerification"/>
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>
    <rule ref="WordPress.Security.SafeRedirect"/>
    <rule ref="WordPress.Security.PluginMenuSlug"/>

    <!-- Catch deprecated/incorrect WP API usage -->
    <rule ref="WordPress.WP.DeprecatedFunctions"/>
    <rule ref="WordPress.WP.DeprecatedParameters"/>
    <rule ref="WordPress.WP.DeprecatedClasses"/>
    <rule ref="WordPress.WP.EnqueuedResources"/>
    <rule ref="WordPress.WP.PostsPerPage"/>
    <rule ref="WordPress.WP.GlobalVariablesOverride"/>

    <!-- Generic PHP / correctness gotchas -->
    <rule ref="WordPress.PHP.NoSilencedErrors"/>
    <rule ref="WordPress.PHP.StrictInArray"/>
    <rule ref="Squiz.PHP.DisallowMultipleAssignments"/>
    <rule ref="WordPress.CodeAnalysis.AssignmentInTernaryCondition"/>
    <rule ref="Squiz.Operators.IncrementDecrementUsage"/>
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter"/>
    <rule ref="Generic.CodeAnalysis.AssignmentInCondition"/>
    <rule ref="WordPress.WP.I18n"/>

    <!-- Formatting (WordPress house style): tabs, single quotes, long array()
         syntax, and `if ( $x )` / `foo( $x )` spacing. Fully auto-fixable with
         `phpcbf` (see .pre-commit-config.yaml). FunctionCallSignature's multi-line
         sub-rules are excluded: they don't converge on the HTML-interleaved
         templates, and re-flowing wrapped calls isn't worth the churn. -->
    <rule ref="Generic.WhiteSpace.DisallowSpaceIndent"/>
    <rule ref="Squiz.Strings.DoubleQuoteUsage"/>
    <rule ref="Universal.Arrays.DisallowShortArraySyntax"/>
    <rule ref="WordPress.WhiteSpace.ControlStructureSpacing"/>
    <rule ref="WordPress.WhiteSpace.OperatorSpacing"/>
    <rule ref="PEAR.Functions.FunctionCallSignature">
        <properties>
            <property name="requiredSpacesAfterOpen" value="1"/>
            <property name="requiredSpacesBeforeClose" value="1"/>
        </properties>
        <exclude name="PEAR.Functions.FunctionCallSignature.OpeningIndent"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.CloseBracketLine"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.ContentAfterOpenBracket"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.ContentBeforeCloseBracket"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.Indent"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.MultipleArguments"/>
    </rule>

    <!-- Cross-version PHP compatibility checks -->
    <rule ref="PHPCompatibilityWP"/>

    <!-- ==================================================================
         Deliberately not adopted from the WordPress standard.

         Each entry is a decision we've made and don't intend to revisit, not
         a backlog item. These become <exclude> elements once the include list
         above is replaced by <rule ref="WordPress"/>.

         - WordPress.PHP.YodaConditions
           `'page' === $posttype` reads backwards. Yoda exists to stop the
           `if ( $x = 5 )` typo, and Generic.CodeAnalysis.AssignmentInCondition
           (enabled above) already catches that class of bug directly, so the
           readability cost buys us nothing.
         ================================================================== -->
</ruleset>
