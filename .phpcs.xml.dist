<?xml version="1.0"?>
<ruleset name="OpenSpendingCoalition">
    <description>Coding standards for the Open Spending Coalition theme: the WordPress standard, minus the exclusions below.</description>

    <file>.</file>

    <exclude-pattern>*/.claude/*</exclude-pattern>
    <exclude-pattern>*/acf_json/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="parallel" value="8"/>

    <config name="testVersion" value="8.1-"/>
    <config name="minimum_supported_wp_version" value="6.1"/>
    <config name="text_domain" value="openspendingcoalition"/>

    <rule ref="WordPress">
        <!-- Yoda conditions read backwards, and Generic.CodeAnalysis.AssignmentInCondition
             already catches the `if ( $x = 5 )` typo they exist to prevent. -->
        <exclude name="WordPress.PHP.YodaConditions"/>

        <!-- Short config arrays are clearer on one line:
             array( 'slug' => 'news', 'with_front' => true ). -->
        <exclude name="WordPress.Arrays.ArrayDeclarationSpacing.AssociativeArrayFound"/>
    </rule>

    <!-- Filenames in these three places are derived from code, not chosen:
         archive.php and single.php locate partials as
         '/archives/' . get_post_type() . '.php', so archives/best_practices.php
         has to keep its underscore — renaming it drops through to the generic
         layout silently rather than erroring. acf_block/*.php match the ACF block
         names they render. Everywhere else the convention applies as normal. -->
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>acf_block/*</exclude-pattern>
        <exclude-pattern>archives/*</exclude-pattern>
        <exclude-pattern>singles/*</exclude-pattern>
    </rule>

    <!-- These assemble their markup from escaped parts only, so callers don't have
         to escape what they return. -->
    <rule ref="WordPress.Security.EscapeOutput">
        <properties>
            <property name="customAutoEscapedFunctions" type="array">
                <element value="breadcrumb_section"/>
                <element value="custom_query_pagination"/>
                <element value="main_query_pagination"/>
            </property>
        </properties>
    </rule>

    <!-- includes.php has a file comment, but the sniff treats a docblock followed
         by a require as the require's docblock, so it can't see it. -->
    <rule ref="Squiz.Commenting.FileComment.Missing">
        <exclude-pattern>inc/includes.php</exclude-pattern>
    </rule>

    <rule ref="PHPCompatibilityWP"/>
</ruleset>
